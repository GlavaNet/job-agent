[Unit]
Description=Job Agent Pipeline Runner
After=network.target

[Service]
# NOTE: replace /home/user/job-agent below (both lines) with your repo path
EnvironmentFile=/home/user/job-agent/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/user/job-agent/run_job_agent.sh runner.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
