[Unit]
Description=Auto-generate tailored resumes and cover letters for high-scoring jobs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=<YOUR_USERNAME>
WorkingDirectory=<YOUR_PROJECT_DIR>
ExecStart=/usr/bin/python3 /path/to/auto_generate_resume_cover_letter.py
StandardOutput=journal
StandardError=journal
SyslogIdentifier=job-agent-autogen

# Ensure the script doesn't run forever
TimeoutStartSec=3600

# Log to syslog/journalctl
# View with: journalctl -u job-agent-autogen.service -f
