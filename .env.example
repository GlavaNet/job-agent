# ============================================================
# job-agent environment configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.
# ============================================================

# --- Data directory ---
# Where jobs.db (+ WAL/SHM sidecars), manual_jobs.txt, processed_jobs.txt,
# seen_jobs.json, preference_profile.json, and resume/ all live.
# Read by config.py, database.py, job_cache.py, and preference_engine.py,
# and by scripts/backup.sh (same variable, same meaning, shared by the
# app and the backup tooling).
#
# Defaults to "." (the current working directory) if unset — matches
# the original bare-metal behaviour exactly. In Docker, compose.yaml
# sets this to /app/state for every service, since that's where the
# host's ./data directory is bind-mounted.
JOBAGENT_DATA_DIR=/app/state

# --- Adzuna API (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# --- Brave Search API (https://brave.com/search/api/) ---
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# --- Findwork (https://findwork.dev/) ---
FINDWORK_API_KEY=your_findwork_key

# --- USAJobs (https://developer.usajobs.gov/apirequest/) ---
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# --- ntfy.sh topics (keep these private — anyone with the topic
#     string can read your notifications) ---
NTFY_INBOX_TOPIC=your_unique_inbox_topic_here
NTFY_NOTIFICATION_TOPIC=your_unique_notification_topic_here

# --- Optional: lock down dashboard / runner endpoint ---
DASHBOARD_SECRET=your-dashboard-password
RUNNER_SECRET=your-runner-token

# --- LLM backend ---
# NOTE: OLLAMA_BASE_URL is overridden to http://ollama:11434 by
# compose.yaml's `environment:` block for every service — the ollama
# container is reachable by that service name on the job-agent-net
# docker network. Leave this here for reference / non-Docker runs only.
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.1:8b

# --- Pipeline behaviour ---
FOLLOWUP_DAYS=14
COVER_LETTER_TIMEOUT_MINUTES=10

# --- Interview prep context limits (chars sent to the LLM) ---
# Defaults are sized for a local 4096-token Ollama model.
# Bump these up if you switch to an API-based model with a larger context window.
PREP_RESUME_CHARS=600
PREP_DESCRIPTION_CHARS=400
PREP_COMPANY_RESEARCH_CHARS=300
