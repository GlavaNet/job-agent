# ============================================================
# job-agent environment configuration
# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and must never be committed.
# ============================================================

# --- Project vars for systemd deployment ---
JOB_AGENT_HOME=
JOB_AGENT_USER=

# --- Adzuna API (https://developer.adzuna.com/) ---
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_API_KEY=your_adzuna_api_key_here

# --- Brave Search API (https://brave.com/search/api/) ---
BRAVE_SEARCH_API_KEY=your_brave_api_key_here

# --- ntfy.sh topics (keep these private-- anyone with the topic
#     string can read your notifications) ---
NTFY_INBOX_TOPIC=your_unique_inbox_topic_here
NTFY_NOTIFICATION_TOPIC=your_unique_notification_topic_here

# ----Backups----

PROJECT_NAME=job-agent

# Directory containing the state files to back up (jobs.db,
# manual_jobs.txt, preference_profile.json, processed_jobs.txt,
# seen_jobs.json). Defaults to the job-agent repo root if unset.
# JOBAGENT_DATA_DIR=/home/chris/job-agent

# BACKUP_LOCAL_DIR=
# BACKUP_SECOND_DISK_DIR=

# age recipient (public key) - generate with:
#   mkdir -p ~/.age && age-keygen -o ~/.age/job-agent-backup-key.txt
#   chmod 600 ~/.age/job-agent-backup-key.txt
# then paste the "Public key: age1..." line it prints below.
# Back up job-agent-backup-key.txt itself SEPARATELY from your backups
# (password manager, printed copy, etc.) - lose it and backups are unrecoverable.
# BACKUP_AGE_RECIPIENT=

# BACKUP_RETENTION_DAYS=56

# --- Offsite Copy 3a: Tailscale to your Raspberry Pi ---
# BACKUP_USE_TAILSCALE=true
# BACKUP_REMOTE_HOST=
# BACKUP_REMOTE_PATH=/backups/job-agent

# --- Offsite Copy 3b: rclone to Backblaze B2 ---
# BACKUP_USE_RCLONE=true
# BACKUP_RCLONE_REMOTE=b2backup
# BACKUP_RCLONE_PATH=job-agent-backups

# BACKUP_LOG_MAX_BYTES=5242880
# BACKUP_LOG_KEEP=8
